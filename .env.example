# Copy this file to .env.local and fill in each value.

# Auth.js — generate with: npx auth secret
AUTH_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mailgun → Sending → Domains (sandbox domain is fine for testing)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Only change this if your Mailgun account is in the EU region: https://api.eu.mailgun.net
MAILGUN_API_URL=https://api.mailgun.net

# Only needed if you deploy somewhere other than Vercel
# AUTH_TRUST_HOST=true
